#!/bin/bash
# ============================================================
#  LyricFlow — One-Command Pipeline Launcher (Optimized)
#  Usage: ./start
#
#  1. Drop MP3 files into input_songs/
#  2. Drop matching .txt files into ground_truth_lyrics/
#  3. Run: ./start
#
#  Performance flags:
#    --workers 20             Total parallel job slots
#    --max-render-workers 6   Max concurrent FFmpeg encodes
# ============================================================

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR"

echo ""
echo "╔══════════════════════════════════════════════════════╗"
echo "║   🎵 LyricFlow Pipeline (Optimized) Starting       ║"
echo "╚══════════════════════════════════════════════════════╝"
echo ""

# Use python3.11 (NeMo is installed here)
PYTHON=python3.11

# Verify python3.11 exists
if ! command -v $PYTHON &> /dev/null; then
    echo "❌ python3.11 not found. Please install it:"
    echo "   brew install python@3.11"
    exit 1
fi

# Check input folder
if [ ! -d "input_songs" ]; then
    mkdir -p input_songs
    echo "📁 Created input_songs/ folder. Drop your MP3 files there!"
    exit 0
fi

MP3_COUNT=$(find input_songs -name "*.mp3" | wc -l | tr -d ' ')
if [ "$MP3_COUNT" = "0" ]; then
    echo "❌ No MP3 files found in input_songs/"
    echo "   Drop your MP3 files there and run ./start again."
    exit 1
fi

echo "🎵 Found $MP3_COUNT MP3 file(s) to process"
echo ""

# Show optimization info
echo "⚡ Optimizations enabled:"
echo "   • Internal rendering at 960×540 (4x less memory)"
echo "   • VideoToolbox hardware encoding (if available)"
echo "   • Shared NeMo model server (loaded once)"
echo "   • Semaphore-limited concurrent renders"
echo ""

# Ensure folders exist
mkdir -p ground_truth_lyrics
mkdir -p output_song

# Log file — capture everything (stdout + stderr) to file AND terminal
LOG_FILE="output_song/pipeline.log"
echo "📝 Logging to: $LOG_FILE"
exec > >(tee -a "$LOG_FILE") 2>&1

# Run the batch processor (safe to fail without killing script)
set +e
$PYTHON batch_processor.py "$@"
EXIT_CODE=$?
set -e

# Cleanup NeMo server PID files if they exist
rm -f output_song/.nemo_server.pid output_song/.nemo_server.ready

echo ""
if [ "$EXIT_CODE" -ne 0 ]; then
    echo "╔══════════════════════════════════════════════════════╗"
    echo "║    ❌ Pipeline finished with errors (exit $EXIT_CODE)     ║"
    echo "║    Check output_song/benchmark.csv for details      ║"
    echo "╚══════════════════════════════════════════════════════╝"
    exit $EXIT_CODE
fi

echo "╔══════════════════════════════════════════════════════╗"
echo "║         ✅ All done! Check output_song/ folder      ║"
echo "╚══════════════════════════════════════════════════════╝"
