# LyricFlow Configuration
# Copy this file to .env and fill in your keys

# Google Gemini API Key (Required for punctuation and forced alignment)
# Get it from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Multiple Gemini API Keys (comma-separated) for round-robin rotation
# This linearly increases throughput by distributing requests across keys
# If set, this takes priority over GEMINI_API_KEY
# GEMINI_API_KEYS=key1,key2,key3

# Pool-specific keys (optional — falls back to GEMINI_API_KEYS if not set)
# Prevents image retries from starving alignment requests
# GEMINI_KEYS_ALIGNMENT=key1,key2,key3
# GEMINI_KEYS_IMAGE=key4
# GEMINI_KEYS_PUNCTUATION=key5

# Google Drive (via Rclone) Configuration
# Remote name from 'rclone config'
GDRIVE_REMOTE=bhajan_drive
# Target folder on Google Drive
GDRIVE_FOLDER=Bhajan Video Complete

# Optional: FFmpeg path (if not in system PATH)
# FFMPEG_PATH=C:\path\to\ffmpeg.exe
